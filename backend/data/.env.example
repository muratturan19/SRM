# Operon_CRM — Backend Environment Variables
# Copy this file to backend/.env and adjust values if needed.

# ── Portal SaaS / SSO ────────────────────────────────────────────
PORTAL_URL=https://portal.kolektif360.com
PORTAL_ISSUER=https://portal.kolektif360.com
PORTAL_APP_SLUG=operon_crm
RELAY_URL=https://portal.kolektif360.com

# ── PostgreSQL tenant DB host settings ───────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ── Provider preferences via portal relay ────────────────────────
SCAN_PROVIDER=claude
VOICE_LLM_PROVIDER=claude
VOICE_LLM_MODEL=claude-sonnet-4-6
VOICE_LLM_FALLBACK_MODEL=gpt-5.5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# ── File storage ─────────────────────────────────────────────────
UPLOAD_DIR=./uploads
DATA_DIR=./data
